{
  "name": "oasis-impex",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --if-present --parallel dev",
    "build": "pnpm -r --if-present build",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:unit": "pnpm -r --if-present test:unit",
    "test:integration": "pnpm -r --if-present test:integration",
    "test:e2e": "pnpm --filter @oasis/web test:e2e",
    "db:migrate": "pnpm --filter @oasis/db db:migrate",
    "db:generate": "pnpm --filter @oasis/db db:generate",
    "db:seed": "pnpm --filter @oasis/db db:seed",
    "db:reset": "pnpm --filter @oasis/db db:reset"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "cpu-features",
      "esbuild",
      "protobufjs",
      "sharp",
      "ssh2"
    ]
  }
}
