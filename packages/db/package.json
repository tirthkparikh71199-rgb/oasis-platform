{
  "name": "@oasis/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:reset": "tsx src/reset.ts",
    "db:seed": "tsx src/seed.ts",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run src --exclude 'src/integration.test.ts'",
    "test:integration": "vitest run src/integration.test.ts"
  },
  "dependencies": {
    "@oasis/config": "workspace:*",
    "argon2": "^0.41.1",
    "drizzle-orm": "^0.38.3",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.15.0",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.30.1",
    "testcontainers": "^10.15.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
