# =============================================================
# OASIS IMPEX — Environment template
# Copy to .env and fill. NEVER commit real values.
# Profile: DEV (default) — all mocks work with empty credentials.
# =============================================================

# --- App ---
NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3000/admin
API_URL=http://localhost:3000/api
SESSION_SECRET=change-me-to-a-long-random-string-32bytes-min

# --- Database ---
DATABASE_URL=postgresql://oasis:oasis@localhost:5432/oasis
DATABASE_URL_READONLY=postgresql://oasis:oasis@localhost:5432/oasis

# --- AI (Gemini free) ---
AI_PROVIDER=gemini
AI_MODEL=gemini-2.0-flash
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# --- Email (Gmail SMTP App Password for dev; official accounts later) ---
EMAIL_TRANSPORT=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Oasis Impex <no-reply@oasisimpex.in>
EMAIL_REPLY_TO=info@oasisimpex.in
EMAIL_INBOX_HOST=imap.gmail.com
EMAIL_INBOX_PORT=993
EMAIL_INBOX_USER=
EMAIL_INBOX_PASS=
ADMIN_ALERT_EMAIL=tirthkparikh71199@gmail.com

# --- WhatsApp (Meta Cloud API; sandbox when empty) ---
WHATSAPP_PROVIDER=sandbox
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_URL=

# --- Backups ---
BACKUP_ENCRYPTION_KEY=change-me-32-bytes-min
BACKUP_REMOTE=
BACKUP_RETENTION_DAILY=14
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=3

# --- DuckDNS (launch hostname until oasisimpex.in DNS handover) ---
DUCKDNS_TOKEN=
DUCKDNS_SUBDOMAIN=oasisimpex
DUCKDNS_HOST=duckdns.org

# --- Monitoring / misc (optional) ---
SENTRY_DSN=
GA_MEASUREMENT_ID=

# --- Seed admin (first-run only; change after login) ---
SEED_ADMIN_EMAIL=admin@oasisimpex.in
SEED_ADMIN_PASSWORD=ChangeMe123!
